  "theme": "base",
  "flowchart": {
    "curve": "monotoneY",
    "htmlLabels": true,
    "nodeSpacing": 50,
    "rankSpacing": 55,
    "padding": 16
  },
  "themeVariables": {
    "fontFamily": "Times New Roman, serif",
    "fontSize": "12px",
    "primaryTextColor": "#1a1a2e",
